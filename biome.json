{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error",
        "noUnusedVariables": { "level": "warn", "fix": "none" },
        "noUnusedFunctionParameters": { "level": "warn", "fix": "none" },
        "noUnusedImports": { "level": "warn", "fix": "none" },
        "useExhaustiveDependencies": { "level": "warn", "fix": "none" }
      },
      "style": {
        "useComponentExportOnlyModules": "warn",
        "useConst": { "level": "warn", "fix": "none" }
      },
      "suspicious": {
        "noLeakedRender": "error",
        "noDebugger": { "level": "warn", "fix": "none" }
      },
      "complexity": {
        "noUselessFragments": { "level": "warn", "fix": "none" }
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "options": {
            "attributes": ["className"],
            "functions": ["clsx", "twMerge", "cva"]
          }
        }
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
